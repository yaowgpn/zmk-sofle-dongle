#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    grave_esc: grave_esc {
        compatible = "zmk,behavior-mod-morph";
        label = "GRAVE_ESC";
        bindings = <&kp ESCAPE>, <&kp GRAVE>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
    };

    tilde_esc: tilde_esc {
        compatible = "zmk,behavior-mod-morph";
        label = "TILDE_ESC";
        bindings = <&kp ESC>, <&grave_esc>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        CAPLOCK {
            bindings = <&kp CAPSLOCK>;
            key-positions = <51 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&tilde_esc  &kp N1     &kp N2        &kp N3        &kp N4  &kp N5           &kp UP_ARROW      &kp N6     &kp N7  &kp N8     &kp N9         &kp N0             &kp DELETE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T            &kp DOWN_ARROW    &kp Y      &kp U   &kp I      &kp O          &kp P              &kp BSLH
&caps_word  &kp A      &kp S         &kp D         &kp F   &kp G            &kp LEFT_ARROW    &kp H      &kp J   &kp K      &kp L          &kp SEMI           &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B            &kp RIGHT_ARROW   &kp N      &kp M   &kp COMMA  &kp DOT        &kp FSLH           &kp RIGHT_SHIFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 2   &kp BACKSPACE    &kp C_PLAY_PAUSE  &kp SPACE  &mo 3   &kp ENTER  &kp RIGHT_ALT  &kp RIGHT_COMMAND
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "L0_QWERT";
            label = "L0_QWERTY";
        };

        Layer0_ColemakDH {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp B     &trans  &kp J   &kp L   &kp U      &kp Y    &kp SEMI  &trans
&trans  &kp A   &kp R   &kp S   &kp T   &kp G     &trans  &kp M   &kp N   &kp E      &kp I    &kp O     &trans
&trans  &kp Z   &kp X   &kp C   &kp D   &kp V     &trans  &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans     &trans   &trans
            >;

            label = "L0_Colemak";
        };

        layer_2nav {
            bindings = <
&kp GRAVE   &kp F1      &kp F2     &kp F3     &kp F4     &kp F5      &mmv MOVE_UP     &kp F6     &kp F7        &kp F8    &kp F9         &kp F10     &kp F11
&trans      &kp INSERT  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MB5    &mmv MOVE_DOWN   &kp PG_UP  &kp HOME      &kp UP    &kp END        &kp INSERT  &kp F12
&trans      &kp TILDE   &trans     &trans     &trans     &mkp MB4    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT      &kp DOWN  &kp RIGHT      &kp MINUS   &kp EQUAL
&trans      &kp LG(Z)   &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans      &mmv MOVE_RIGHT  &trans     &kp LA(LEFT)  &none     &kp LA(RIGHT)  &kp LBKT    &kp RBKT
&kp C_MUTE  &trans      &trans     &trans     &trans     &trans      &trans           &trans     &to 4         &trans    &trans         &trans
            >;

            display-name = "layer1";
            sensor-bindings = <&scroll_encoder>;
            label = "L2 NAV";
        };

        L3_NUM_Sym {
            bindings = <
&kp TILDE        &kp F1         &kp F2        &kp F3                &kp F4                 &kp F5                  &mmv MOVE_UP     &kp F6                 &kp F7  &kp F8  &kp F9   &kp F10    &kp F11
&kp EXCLAMATION  &kp AT_SIGN    &kp POUND     &kp DOLLAR            &kp PERCENT            &kp LEFT_BRACKET        &mmv MOVE_DOWN   &kp RIGHT_BRACKET      &kp N7  &kp N8  &kp N9   &kp MINUS  &kp F12
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS    &mmv MOVE_LEFT   &kp RIGHT_PARENTHESIS  &kp N4  &kp N5  &kp N6   &kp MINUS  &kp PLUS
&trans           &kp EQUAL      &kp MINUS     &kp LESS_THAN         &kp GREATER_THAN       &kp LEFT_BRACE          &mmv MOVE_RIGHT  &kp RIGHT_BRACE        &kp N1  &kp N2  &kp N3   &kp SLASH  &kp ASTERISK
&trans           &trans         &trans        &trans                &to 4                  &trans                  &trans           &trans                 &trans  &kp N0  &kp DOT  &kp EQUAL
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "L3 Num&Symbol";
        };

        L4_ADJ {
            display-name = "layer1";
            bindings = <
&tog 1           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &mmv MOVE_UP     &none  &none         &none             &none            &none  &sys_reset
&out OUT_TOG     &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &none         &bt BT_CLR    &bt BT_CLR_ALL    &mmv MOVE_DOWN   &none  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOLUME_UP  &none  &none
&rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none         &none         &none             &mmv MOVE_LEFT   &none  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT       &none  &none
&none            &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &none         &none         &none             &mmv MOVE_RIGHT  &none  &none         &none             &none            &none  &none
&kp C_MUTE       &none            &none            &none         &tog 4        &none             &trans           &none  &tog 4        &none             &none            &none
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "L4_ADJ_MEDIA";
        };
    };
};
