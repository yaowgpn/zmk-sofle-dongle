#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    grave_esc: grave_esc {
        compatible = "zmk,behavior-mod-morph";
        label = "GRAVE_ESC";
        bindings = <&kp GRAVE>, <&kp TILDE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    tilde_esc: tilde_esc {
        compatible = "zmk,behavior-mod-morph";
        label = "TILDE_ESC";
        bindings = <&kp ESC>, <&grave_esc>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI|MOD_LSFT|MOD_RSFT)>;
    };

    toggle_on: toggle_on {
        compatible = "zmk,behavior-toggle-layer";
        label = "TOGGLE_ON";
        #binding-cells = <1>;
    };

    toggle_off: toggle_off {
        compatible = "zmk,behavior-toggle-layer";
        label = "TOGGLE_OFF";
        #binding-cells = <1>;
        toggle-mode = "off";
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        CAPLOCK {
            bindings = <&kp CAPSLOCK>;
            key-positions = <51 39>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&tilde_esc  &kp N1     &kp N2        &kp N3        &kp N4       &kp N5           &kp UP_ARROW      &kp N6     &kp N7  &kp N8     &kp N9         &kp N0         &kp MINUS
&kp TAB     &kp Q      &kp W         &kp E         &kp R        &kp T            &kp DOWN_ARROW    &kp Y      &kp U   &kp I      &kp O          &kp P          &kp BSLH
&caps_word  &kp A      &kp S         &kp D         &kp F        &kp G            &kp LEFT_ARROW    &kp H      &kp J   &kp K      &kp L          &kp SEMI       &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V        &kp B            &kp RIGHT_ARROW   &kp N      &kp M   &kp COMMA  &kp DOT        &kp FSLH       &kp RIGHT_SHIFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 ENTER  &kp BACKSPACE    &kp C_PLAY_PAUSE  &kp SPACE  &mo 3   &kp DEL    &kp RIGHT_GUI  &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "L0 QWERTY";
            label = "L0_QWERTY";
        };

        Layer1_ColemakDH {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp B     &trans  &kp J   &kp L   &kp U      &kp Y    &kp SEMI  &trans
&trans  &kp A   &kp R   &kp S   &kp T   &kp G     &trans  &kp M   &kp N   &kp E      &kp I    &kp O     &trans
&trans  &kp Z   &kp X   &kp C   &kp D   &kp V     &trans  &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans     &trans   &trans
            >;

            display-name = "L1 Colemak";
            label = "L1_Colemak";
        };

        layer2_nav {
            bindings = <
&kp GRAVE   &kp F1     &kp F2             &kp F3         &kp F4            &kp F5      &mmv MOVE_UP     &kp F6     &kp F7        &kp F8    &kp F9         &kp F10    &kp F11
&trans      &trans     &mkp LCLK          &mkp MCLK      &mkp RCLK         &mkp MB5    &mmv MOVE_DOWN   &kp PG_UP  &kp HOME      &kp UP    &kp END        &kp MINUS  &kp F12
&trans      &kp TILDE  &kp C_VOLUME_DOWN  &kp C_PP       &kp C_VOL_UP      &mkp MB4    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT      &kp DOWN  &kp RIGHT      &kp STAR   &kp PLUS
&trans      &kp MINUS  &kp EQUAL          &kp LESS_THAN  &kp GREATER_THAN  &trans      &mmv MOVE_RIGHT  &trans     &kp LA(LEFT)  &none     &kp LA(RIGHT)  &kp SLASH  &trans
&kp C_MUTE  &trans     &trans             &trans         &trans            &trans      &trans           &trans     &to 4         &trans    &trans         &kp EQUAL
            >;

            display-name = "L2 Navigation";
            sensor-bindings = <&scroll_encoder>;
            label = "L2_NAV";
        };

        Layer3_NUM_Sym {
            bindings = <
&kp GRAVE        &kp F1         &kp F2        &kp F3                &kp F4                 &kp F5                  &mmv MOVE_UP     &kp F6                 &kp F7  &kp F8  &kp F9   &kp F10       &kp F11
&kp EXCLAMATION  &kp AT_SIGN    &kp POUND     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACE          &mmv MOVE_DOWN   &kp RIGHT_BRACE        &kp N7  &kp N8  &kp N9   &kp MINUS     &kp F12
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS    &mmv MOVE_LEFT   &kp RIGHT_PARENTHESIS  &kp N4  &kp N5  &kp N6   &kp ASTERISK  &kp PLUS
&trans           &kp MINUS      &kp EQUAL     &kp LBKT              &kp RBKT               &kp LBKT                &mmv MOVE_RIGHT  &kp RBKT               &kp N1  &kp N2  &kp N3   &trans        &trans
&trans           &trans         &trans        &trans                &to 4                  &trans                  &trans           &trans                 &trans  &kp N0  &kp DOT  &kp EQUAL
            >;

            display-name = "L3 Num&Symbol";
            sensor-bindings = <&scroll_encoder>;
            label = "L3_Num&Symbol";
        };

        L4_ADJ {
            bindings = <
&to 0            &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &mmv MOVE_UP     &none  &none              &none             &none            &none          &sys_reset
&to 1            &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &out OUT_TOG  &bt BT_CLR    &bt BT_CLR_ALL    &mmv MOVE_DOWN   &none  &kp C_PREV         &kp C_PLAY_PAUSE  &kp C_NEXT       &none          &none
&rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none         &none         &none             &mmv MOVE_LEFT   &none  &kp K_VOLUME_DOWN  &kp C_MUTE        &kp C_VOLUME_UP  &none          &none
&trans           &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &none         &none         &none             &mmv MOVE_RIGHT  &none  &none              &none             &none            &none          &none
&kp C_MUTE       &trans           &trans           &trans        &tog 4        &none             &trans           &none  &tog 4             &none             &kp RIGHT_GUI    &kp RIGHT_ALT
            >;

            display-name = "L4 Adj&Media";
            sensor-bindings = <&scroll_encoder>;
            label = "L4_ADJ_MEDIA";
        };
    };
};
